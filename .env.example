# --- Database (Neon Postgres) ------------------------------------------------
# Pooled connection — used by the Next.js app at runtime.
# Get it from Neon dashboard: Connection details > "Pooled connection".
DATABASE_URL=""


# Direct (unpooled) connection — used only by Drizzle migrations.
# Get it from Neon dashboard: Connection details > untick "Pooled connection".
DATABASE_URL_DIRECT=""

# --- Cron security -----------------------------------------------------------
# Random string, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In Vercel, this is also what protects the cron endpoint.
CRON_SECRET=""

# --- Admin operations --------------------------------------------------------
# Separate from CRON_SECRET — used to authenticate manual admin endpoints
# like /api/admin/recompute-scores. Same 32-char minimum. Different rotation
# cadence than CRON_SECRET (rotate independently when ops change hands).
# Generate the same way as CRON_SECRET.
ADMIN_SECRET=""

# --- Clerk (authentication) --------------------------------------------------
# From Clerk dashboard > API keys. The publishable key is the only one that
# ships to the browser (NEXT_PUBLIC_). The secret key is server-only.
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
# Point Clerk at our custom pages (defaults already match these routes).
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
# Webhook signing secret — from Clerk dashboard > Webhooks > your endpoint.
# Leave blank until the webhook endpoint is created (sign-in still works without it).
CLERK_WEBHOOK_SIGNING_SECRET=""

# --- Resend (application email) ----------------------------------------------
# From resend.com > API Keys. Optional in dev — welcome email is skipped if blank.
RESEND_API_KEY=""
# Sending address. Use Resend's sandbox until myafriquant.com DNS is verified,
# then switch to e.g. "AfriQuant <welcome@myafriquant.com>".
EMAIL_FROM="AfriQuant <onboarding@resend.dev>"

# --- Environment -------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_ENV="development"

# --- Data freshness (shown in the demo banner) -------------------------------
NEXT_PUBLIC_DATA_SOURCE="AfriQuant Prototype"
NEXT_PUBLIC_LAST_UPDATED="2026-04-21"
