# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# ingest drop-zones (operator transcriptions live here, may contain
# copyrighted PDF excerpts and other sensitive data)
/ingest/
!ingest/.gitkeep
!ingest/prices/.gitkeep
!ingest/prices/sample.csv.example
!ingest/research/.gitkeep
!ingest/research/sample.json.example
!ingest/analysts/.gitkeep
!ingest/analysts/sample.json.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
